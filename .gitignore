# The venv: torch and its wheels, machine-local and several gigabytes of it.
.venv/
__pycache__/
*.pyc

# What the trainers write. A generator is ~90 MB and a checkpoint ~400 MB; ship those as release
# assets rather than commits.
*.onnx
*.npy
*.npz
*.pt
*.log

# What the tools write to look at. The lab's own pages are not that.
*.html
!app/static/*.html
*.png

# The photographs themselves (the lab's pictures and textures, full size, some of people): kept on the
# machine, never in a public history.
dataset/

# This machine's launchers.
.claude/
onnxruntime_profile__*.json
paths.local.sh
